{
  "name": "solid-styled",
  "version": "0.12.1",
  "private": false,
  "description": "Reactive stylesheets for SolidJS",
  "keywords": [
    "compiler",
    "css",
    "oxc",
    "solid-js",
    "styled"
  ],
  "homepage": "https://github.com/lxsmnsyc/solid-styled/tree/main/packages/solid-styled",
  "bugs": {
    "url": "https://github.com/lxsmnsyc/solid-styled/issues"
  },
  "license": "MIT",
  "author": "Alexis Munsayac",
  "repository": {
    "type": "git",
    "url": "https://github.com/lxsmnsyc/solid-styled.git"
  },
  "files": [
    "dist",
    "src",
    "compiler"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./compiler": "./dist/compiler.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "tsdown",
    "build": "tsdown",
    "watch": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "browserslist": "^4.28.8",
    "css-tree": "^3.2.1",
    "lightningcss": "^1.33.0",
    "magic-string": "^1.2.3",
    "oxc-parser": "^0.148.0"
  },
  "devDependencies": {
    "@solidjs/web": "2.0.0-rc.5",
    "@types/css-tree": "^3.2.0",
    "@types/node": "^26.4.1",
    "solid-js": "2.0.0-rc.5",
    "tsdown": "^0.22.14",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@solidjs/web": "^2.0.0-rc.5",
    "solid-js": "^2.0.0-rc.5"
  },
  "engines": {
    "node": ">=18"
  }
}
