{
  "name": "solid-styled",
  "version": "1.0.0-next.1",
  "private": false,
  "description": "Reactive stylesheets for SolidJS",
  "keywords": [
    "compiler",
    "css",
    "oxc",
    "solid-js",
    "styled"
  ],
  "homepage": "https://github.com/lxsmnsyc/solid-styled/tree/main/packages/solid-styled",
  "bugs": {
    "url": "https://github.com/lxsmnsyc/solid-styled/issues"
  },
  "license": "MIT",
  "author": "Alexis Munsayac",
  "repository": {
    "type": "git",
    "url": "https://github.com/lxsmnsyc/solid-styled.git"
  },
  "files": [
    "dist",
    "src",
    "compiler"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./compiler": "./dist/compiler.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "tsdown",
    "build": "tsdown",
    "watch": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "browserslist": "^4.29.5",
    "css-tree": "^3.2.1",
    "lightningcss": "^1.33.0",
    "magic-string": "^1.4.5",
    "oxc-parser": "^0.157.0"
  },
  "devDependencies": {
    "@solidjs/compiler": "2.0.0-rc.21",
    "@solidjs/web": "2.0.0-rc.21",
    "@types/css-tree": "^3.2.0",
    "@types/node": "^26.6.6",
    "fast-check": "^4.10.2",
    "happy-dom": "^21.0.4",
    "js-xxhash": "^5.0.1",
    "solid-js": "2.0.0-rc.21",
    "solid-styled-legacy": "npm:solid-styled@0.12.1",
    "tsdown": "^0.23.7",
    "tslib": "^2.9.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "@solidjs/web": "^2.0.0-rc.5",
    "solid-js": "^2.0.0-rc.5"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
