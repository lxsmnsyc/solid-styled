{
  "name": "root",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*",
    "website"
  ],
  "type": "module",
  "scripts": {
    "cs:ver": "changeset version && pnpm install --lockfile-only",
    "cs:pub": "changeset publish",
    "cs:add": "changeset add",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "build": "pnpm recursive run build",
    "test": "pnpm --filter solid-styled run test",
    "test:e2e": "pnpm --filter demo run test:e2e",
    "typecheck": "pnpm recursive run typecheck"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@lxsmnsyc/oxlint-config": "^0.1.3",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.15.0"
}
